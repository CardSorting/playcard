// Collection helper functions
function isCollectionOwner(collectionId) {
  return get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
}

function isCollectionCollaborator(collectionId) {
  let sharing = get(/databases/$(database)/documents/collectionSharing/$(collectionId));
  return sharing != null && sharing.data.collaborators[request.auth.uid] != null;
}

function hasCollectionEditAccess(collectionId) {
  let sharing = get(/databases/$(database)/documents/collectionSharing/$(collectionId));
  return sharing != null && sharing.data.collaborators[request.auth.uid].role == 'editor';
}

function isValidCollectionCard(card) {
  return card.size() > 0
    && card.cardId.size() > 0
    && card.snapshot.size() > 0
    && card.snapshot.name.size() > 0
    && card.snapshot.type.matches('^(Normal|Fire|Water|Electric|Grass|Ice|Fighting|Poison|Ground|Flying|Psychic|Bug|Rock|Ghost|Dragon|Dark|Steel|Fairy)$');
}

// Collections
match /collections/{collectionId} {
  allow read: if isAuthenticated() && (
    resource.data.isPublic == true || 
    isCollectionOwner(collectionId) ||
    isCollectionCollaborator(collectionId)
  );
  allow create: if isAuthenticated() 
    && request.resource.data.userId == request.auth.uid;
  allow update: if isAuthenticated() && (
    isCollectionOwner(collectionId) ||
    hasCollectionEditAccess(collectionId)
  );
  allow delete: if isAuthenticated() && isCollectionOwner(collectionId);
}

// Collection Cards
match /collectionCards/{cardId} {
  allow read: if isAuthenticated() && (
    get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.isPublic == true ||
    isCollectionOwner(resource.data.collectionId) ||
    isCollectionCollaborator(resource.data.collectionId)
  );
  allow create: if isAuthenticated() 
    && isCollectionOwner(request.resource.data.collectionId)
    && isValidCollectionCard(request.resource.data);
  allow update: if isAuthenticated() && (
    isCollectionOwner(resource.data.collectionId) ||
    hasCollectionEditAccess(resource.data.collectionId)
  );
  allow delete: if isAuthenticated() && isCollectionOwner(resource.data.collectionId);
}

// Collection Stats
match /collectionStats/{statsId} {
  allow read: if isAuthenticated() && (
    get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.isPublic == true ||
    isCollectionOwner(resource.data.collectionId) ||
    isCollectionCollaborator(resource.data.collectionId)
  );
  allow write: if false; // Only through functions
}

// Collection Sharing
match /collectionSharing/{sharingId} {
  allow read: if isAuthenticated() && (
    isCollectionOwner(sharingId) ||
    resource.data.collaborators[request.auth.uid] != null ||
    (resource.data.visibility == 'link' && request.auth.token.email == resource.data.shareLink.allowedEmail)
  );
  allow create: if isAuthenticated() && isCollectionOwner(request.resource.data.collectionId);
  allow update: if isAuthenticated() && (
    isCollectionOwner(resource.data.collectionId) ||
    (resource.data.collaborators[request.auth.uid].role == 'editor' &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessLog']))
  );
  allow delete: if isAuthenticated() && isCollectionOwner(resource.data.collectionId);
}

// Collection Achievements
match /collectionAchievements/{achievementId} {
  allow read: if isAuthenticated() && (
    resource.data.userId == request.auth.uid ||
    get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.isPublic == true
  );
  allow write: if false; // Only through functions
}

// Collection Trades
match /collectionTrades/{tradeId} {
  allow read: if isAuthenticated() && (
    resource.data.initiatorId == request.auth.uid ||
    resource.data.recipientId == request.auth.uid
  );
  allow create: if isAuthenticated() 
    && request.resource.data.initiatorId == request.auth.uid
    && request.resource.data.offer.size() == 2;
  allow update: if isAuthenticated() && (
    resource.data.initiatorId == request.auth.uid ||
    resource.data.recipientId == request.auth.uid
  ) && (
    // Only allow updating specific fields
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'offer', 'messages', 'verification', 'updatedAt']) ||
    // Or completing the trade
    (request.resource.data.status == 'completed' && resource.data.verification.initiatorConfirmed && resource.data.verification.recipientConfirmed)
  );
  allow delete: if false; // Trades are archived, not deleted
}

// Collection Display Settings
match /collectionDisplay/{displayId} {
  allow read: if isAuthenticated() && (
    get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.isPublic == true ||
    isCollectionOwner(resource.data.collectionId) ||
    isCollectionCollaborator(resource.data.collectionId)
  );
  allow write: if isAuthenticated() && (
    isCollectionOwner(resource.data.collectionId) ||
    hasCollectionEditAccess(resource.data.collectionId)
  );
}
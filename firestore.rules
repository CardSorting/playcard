rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Common helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isSeller(userId) {
  let user = get(/databases/$(database)/documents/users/$(userId));
  return user != null && user.data.isSeller == true;
}

    function isValidListing(listing) {
  return listing.size() > 0 
    && listing.type.matches('^(card|pack)$')
    && listing.itemId.size() > 0
    && listing.item.size() > 0
    && listing.price > 0
    && listing.quantity > 0
    && listing.sellerId == request.auth.uid
    && listing.sellerName.size() > 0
    && listing.status.matches('^(active|sold|cancelled)$')
    && listing.rating >= 0
    && listing.rating <= 5
    && listing.reviewCount >= 0
    && listing.deliveryTime.size() > 0;
}

    function isValidOrder(order) {
  return order.size() > 0 
    && order.items.size() > 0
    && order.totalAmount > 0
    && order.items[0].price > 0
    && order.items[0].quantity > 0
    && order.paymentStatus.matches('^(pending|completed|failed|refunded)$')
    && order.status.matches('^(pending|processing|completed|cancelled|disputed)$')
    && order.shippingAddress.size() > 0;
}

    function isValidInventory(inventory) {
  return inventory.size() > 0
    && inventory.totalQuantity >= 0
    && inventory.availableQuantity >= 0
    && inventory.reservedQuantity >= 0
    && inventory.totalQuantity == (inventory.availableQuantity + inventory.reservedQuantity);
}

    function isValidReview(review) {
  return review.size() > 0
    && review.listingId.size() > 0
    && review.orderId.size() > 0
    && review.sellerId.size() > 0
    && review.userId == request.auth.uid
    && review.userName.size() > 0
    && review.rating >= 1
    && review.rating <= 5
    && review.comment.size() > 0
    && review.status.matches('^(pending|approved|rejected)$')
    && (!review.title || review.title.size() <= 100)
    && (!review.images || review.images.size() <= 5);
}

    function hasVerifiedPurchase(orderId, userId) {
  let order = get(/databases/$(database)/documents/orders/$(orderId));
  return order != null 
    && order.data.buyerId == userId 
    && order.data.status == 'completed';
}

    function hasValidCartItems(items) {
  return items.size() > 0 && items.hasAll(['id', 'listingId', 'quantity', 'price', 'sellerId']);
}

    function isCardOwner(cardId) {
  return get(/databases/$(database)/documents/cardTemplates/$(cardId)).data.creatorId == request.auth.uid;
}

    function isValidCard(card) {
  return card.size() > 0 
    && card.name.size() > 0 
    && card.type.matches('^(Normal|Fire|Water|Electric|Grass|Ice|Fighting|Poison|Ground|Flying|Psychic|Bug|Rock|Ghost|Dragon|Dark|Steel|Fairy)$')
    && card.creatorId == request.auth.uid;
}

    function isValidGeneration(gen) {
  return gen.size() > 0
    && gen.userId == request.auth.uid
    && gen.prompt.size() > 0;
}

    function isCollaborator(cardId) {
  let collab = get(/databases/$(database)/documents/cardCollaborations/$(cardId));
  return collab != null && (
    collab.data.owner.userId == request.auth.uid ||
    collab.data.collaborators[request.auth.uid] != null
  );
}

    function hasEditPermission(cardId) {
  let collab = get(/databases/$(database)/documents/cardCollaborations/$(cardId));
  return collab != null && (
    collab.data.owner.userId == request.auth.uid ||
    collab.data.collaborators[request.auth.uid].role == 'editor'
  );
}

    // Collection helper functions
    function isCollectionOwner(collectionId) {
      return exists(/databases/$(database)/documents/collections/$(collectionId)) &&
             get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
    }

    function isCollectionCollaborator(collectionId) {
      return exists(/databases/$(database)/documents/collectionSharing/$(collectionId)) &&
             get(/databases/$(database)/documents/collectionSharing/$(collectionId)).data.collaborators[request.auth.uid] != null;
    }

    function hasCollectionEditAccess(collectionId) {
      return exists(/databases/$(database)/documents/collectionSharing/$(collectionId)) &&
             get(/databases/$(database)/documents/collectionSharing/$(collectionId)).data.collaborators[request.auth.uid].role == 'editor';
    }

    function isValidCollectionCard(card) {
      return card.size() > 0
        && card.cardId.size() > 0
        && card.snapshot.size() > 0
        && card.snapshot.name.size() > 0
        && card.snapshot.type.matches('^(Normal|Fire|Water|Electric|Grass|Ice|Fighting|Poison|Ground|Flying|Psychic|Bug|Rock|Ghost|Dragon|Dark|Steel|Fairy)$');
    }


    function isValidPack(pack) {
  return pack.size() > 0
    && pack.userId == request.auth.uid
    && pack.name.size() > 0
    && pack.cards.size() > 0
    && pack.totalCards == pack.cards.size()
    && pack.status.matches('^(draft|published|archived)$')
    && (!pack.description || pack.description.size() <= 500);
}

    function isValidPackOpening(opening) {
  return opening.size() > 0
    && opening.userId == request.auth.uid
    && opening.packId.size() > 0
    && opening.cards.size() > 0
    && opening.pulledRarities.size() > 0;
}

    function isValidPackTemplate(template) {
  return template.size() > 0
    && template.userId == request.auth.uid
    && template.name.size() > 0
    && template.cardCount > 0
    && template.rarityRules.size() > 0;
}

    function isValidPackCollection(collection) {
  return collection.size() > 0
    && collection.userId == request.auth.uid
    && collection.name.size() > 0
    && collection.packs.size() > 0
    && collection.sortOrder.matches('^(name|added|opened|custom)$')
    && (!collection.description || collection.description.size() <= 500);
}

    function canOpenPack(packId) {
  let pack = get(/databases/$(database)/documents/boosterPacks/$(packId));
  return pack != null && (
    pack.data.isPublic == true || 
    pack.data.userId == request.auth.uid
  );
}


    function isDefaultCollection(collectionId) {
      return collectionId.matches('^default-' + request.auth.uid + '$');
    }

    function isPackAnalyticsOwner(packId) {
      let pack = get(/databases/$(database)/documents/boosterPacks/$(packId));
      return pack != null && pack.data.userId == request.auth.uid;
    }

    // Base user rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // marketplace rules
match /listings/{listingId} {
  allow read: if isAuthenticated();
  allow create: if isAuthenticated() 
    && isValidListing(request.resource.data)
    && (
      // For card listings
      (request.resource.data.type == 'card' && 
       request.resource.data.item.type.matches('^(Normal|Fire|Water|Electric|Grass|Ice|Fighting|Poison|Ground|Flying|Psychic|Bug|Rock|Ghost|Dragon|Dark|Steel|Fairy)$')) ||
      // For pack listings
      (request.resource.data.type == 'pack')
    );
  allow update: if isAuthenticated() 
    && request.resource.data.sellerId == resource.data.sellerId 
    && resource.data.sellerId == request.auth.uid
    && request.resource.data.type == resource.data.type
    && request.resource.data.itemId == resource.data.itemId;
  allow delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;

  // Likes subcollection
  match /likes/{userId} {
    allow read: if isAuthenticated();
    allow create: if isAuthenticated() && request.auth.uid == userId;
    allow delete: if isAuthenticated() && request.auth.uid == userId;
  }

  // Reviews subcollection
  match /reviews/{reviewId} {
    allow read: if isAuthenticated();
    allow create: if isAuthenticated() 
      && isValidReview(request.resource.data)
      && hasVerifiedPurchase(request.resource.data.orderId, request.auth.uid);
    allow update: if isAuthenticated() 
      && resource.data.userId == request.auth.uid
      && request.resource.data.userId == resource.data.userId
      && request.resource.data.listingId == resource.data.listingId
      && request.resource.data.orderId == resource.data.orderId
      && request.resource.data.sellerId == resource.data.sellerId;
    allow delete: if false;
  }
}
match /orders/{orderId} {
  allow create: if isAuthenticated() 
    && request.resource.data.buyerId == request.auth.uid 
    && isValidOrder(request.resource.data);
  allow read: if isAuthenticated() 
    && (resource.data.buyerId == request.auth.uid 
        || resource.data.items[0].sellerId == request.auth.uid);
  allow update: if isAuthenticated() 
    && (resource.data.buyerId == request.auth.uid 
        || resource.data.items[0].sellerId == request.auth.uid)
    && request.resource.data.buyerId == resource.data.buyerId
    && request.resource.data.items[0].sellerId == resource.data.items[0].sellerId;
  allow delete: if false;
}
match /inventory/{inventoryId} {
  allow read: if isAuthenticated();
  allow create: if isAuthenticated() 
    && isSeller(request.auth.uid)
    && request.resource.data.sellerId == request.auth.uid
    && isValidInventory(request.resource.data);
  allow update: if isAuthenticated()
    && resource.data.sellerId == request.auth.uid
    && isValidInventory(request.resource.data);
  allow delete: if false;
}
match /disputes/{disputeId} {
  allow read: if isAuthenticated() 
    && (resource.data.buyerId == request.auth.uid 
        || resource.data.sellerId == request.auth.uid);
  allow create: if isAuthenticated() 
    && request.resource.data.buyerId == request.auth.uid
    && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
    && request.resource.data.status == 'open';
  allow update: if isAuthenticated() 
    && (resource.data.buyerId == request.auth.uid 
        || resource.data.sellerId == request.auth.uid)
    && request.resource.data.buyerId == resource.data.buyerId
    && request.resource.data.sellerId == resource.data.sellerId
    && request.resource.data.orderId == resource.data.orderId;
  allow delete: if false;
}
match /transactions/{transactionId} {
  allow read: if isAuthenticated() 
    && (resource.data.buyerId == request.auth.uid 
        || resource.data.sellerId == request.auth.uid);
  allow write: if false; // Only through server functions
}
match /sellerAnalytics/{analyticsId} {
  allow read: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
  allow write: if false; // Only through server functions
}
match /marketStats/{statsId} {
  allow read: if isAuthenticated();
  allow write: if false; // Only through server functions
}
match /users/{userId} {
  allow read: if isAuthenticated();
  allow create: if isAuthenticated() && isOwner(userId);
  allow update: if isAuthenticated() 
    && isOwner(userId)
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSeller', 'sellerRating', 'totalSales', 'totalRevenue']) 
        || (isSeller(userId) && isOwner(userId)));
  allow delete: if false;
}

    // cart rules
match /carts/{cartId} {
  allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
  allow create: if isAuthenticated() 
    && request.resource.data.userId == request.auth.uid
    && (!request.resource.data.items || hasValidCartItems(request.resource.data.items));
  allow update: if isAuthenticated() 
    && resource.data.userId == request.auth.uid
    && request.resource.data.userId == resource.data.userId
    && (!request.resource.data.items || hasValidCartItems(request.resource.data.items));
  allow delete: if false; // Carts are archived, not deleted
}
match /cartAnalytics/{analyticsId} {
  allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
  allow write: if false; // Only through server functions
}
match /cartRecovery/{recoveryId} {
  allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
  allow write: if false; // Only through server functions
}
match /cartValidations/{validationId} {
  allow read: if isAuthenticated() 
    && get(/databases/$(database)/documents/carts/$(resource.data.cartId)).data.userId == request.auth.uid;
  allow write: if false; // Only through server functions
}
match /cartMerges/{mergeId} {
  allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
  allow write: if false; // Only through server functions
}
match /checkoutSessions/{sessionId} {
  allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
  allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
  allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
  allow delete: if false;
}

    // card-creator rules
match /cardTemplates/{cardId} {
  allow read: if isAuthenticated() && (
    resource.data.isPublic == true || 
    resource.data.creatorId == request.auth.uid
  );
  allow create: if isAuthenticated() && isValidCard(request.resource.data);
  allow update: if isAuthenticated() 
    && resource.data.creatorId == request.auth.uid
    && request.resource.data.creatorId == resource.data.creatorId;
  allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
}
match /cardAnalytics/{analyticsId} {
  allow read: if isAuthenticated() && isCardOwner(analyticsId);
  allow update: if isAuthenticated() && (
    // Allow incrementing view count
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'updatedAt']) ||
    // Allow full updates by owner
    isCardOwner(analyticsId)
  );
  allow create, delete: if false;
}
match /cardVersions/{versionId} {
  allow read: if isAuthenticated() && isCardOwner(resource.data.cardId);
  allow create: if isAuthenticated() && isCardOwner(request.resource.data.cardId);
  allow update, delete: if false;
}
match /cardCollections/{collectionId} {
  allow read: if isAuthenticated() && (
    resource.data.isPublic == true || 
    resource.data.userId == request.auth.uid
  );
  allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
  allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
  allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
}

    // card-generation rules
match /cardGeneration/{generationId} {
  allow read: if isAuthenticated() && (
    resource.data.isPublic == true ||
    resource.data.userId == request.auth.uid
  );
  allow create: if isAuthenticated() 
    && isValidGeneration(request.resource.data);
  allow update: if isAuthenticated() 
    && resource.data.userId == request.auth.uid
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['status', 'results', 'error', 'completedAt', 'updatedAt']);
  allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
}
match /cardComments/{commentId} {
  allow read: if isAuthenticated();
  allow create: if isAuthenticated() 
    && request.resource.data.userId == request.auth.uid;
  allow update: if isAuthenticated() 
    && resource.data.userId == request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['content', 'reactions', 'updatedAt', 'editedAt']);
  allow delete: if isAuthenticated() 
    && resource.data.userId == request.auth.uid;
}
match /cardSets/{setId} {
  allow read: if isAuthenticated();
  allow write: if false; // Only through admin functions
}
match /cardAssets/{assetId} {
  allow read: if isAuthenticated() && (
    resource.data.isPublic == true || 
    resource.data.userId == request.auth.uid
  );
  allow create: if isAuthenticated() 
    && request.resource.data.userId == request.auth.uid;
  allow update: if isAuthenticated() 
    && resource.data.userId == request.auth.uid
    && request.resource.data.userId == resource.data.userId;
  allow delete: if isAuthenticated() 
    && resource.data.userId == request.auth.uid;
}

    // card-collaboration rules
match /cardCollaborations/{collaborationId} {
  allow read: if isAuthenticated() && isCollaborator(collaborationId);
  allow create: if isAuthenticated() 
    && request.resource.data.owner.userId == request.auth.uid;
  allow update: if isAuthenticated() && (
    // Owner can update everything
    resource.data.owner.userId == request.auth.uid ||
    // Editors can update activity log
    (hasEditPermission(collaborationId) &&
     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activity']))
  );
  allow delete: if isAuthenticated() 
    && resource.data.owner.userId == request.auth.uid;
}
match /collaborationActivity/{activityId} {
  allow read: if isAuthenticated() 
    && isCollaborator(resource.data.cardId);
  allow create: if isAuthenticated() 
    && isCollaborator(request.resource.data.cardId)
    && request.resource.data.userId == request.auth.uid;
  allow update, delete: if false;
}
match /collaborationInvites/{inviteId} {
  allow read: if isAuthenticated() && (
    resource.data.inviterId == request.auth.uid ||
    resource.data.inviteeEmail == request.auth.token.email
  );
  allow create: if isAuthenticated() 
    && request.resource.data.inviterId == request.auth.uid
    && isCardOwner(request.resource.data.cardId);
  allow update: if isAuthenticated() && (
    // Inviter can cancel
    resource.data.inviterId == request.auth.uid ||
    // Invitee can accept/reject
    resource.data.inviteeEmail == request.auth.token.email
  ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
  allow delete: if isAuthenticated() 
    && resource.data.inviterId == request.auth.uid;
}

    // collection rules
    match /collections/{collectionId} {
      allow read: if isAuthenticated() && (
        resource.data.isPublic == true || 
        isCollectionOwner(collectionId) ||
        isCollectionCollaborator(collectionId) ||
        isDefaultCollection(collectionId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isDefaultCollection(collectionId)
      );
      allow update: if isAuthenticated() && (
        isCollectionOwner(collectionId) ||
        hasCollectionEditAccess(collectionId)
      );
      allow delete: if isAuthenticated() && isCollectionOwner(collectionId);
    }
    match /collectionCards/{cardId} {
      allow read: if isAuthenticated() && (
        exists(/databases/$(database)/documents/collections/$(resource.data.collectionId)) &&
        (
          get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.isPublic == true ||
          get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.userId == request.auth.uid ||
          isCollectionCollaborator(resource.data.collectionId) ||
          isDefaultCollection(resource.data.collectionId)
        )
      );
      allow create: if isAuthenticated() && 
        (isCollectionOwner(request.resource.data.collectionId) ||
         isDefaultCollection(request.resource.data.collectionId)) && 
        isValidCollectionCard(request.resource.data);
      allow update: if isAuthenticated() && (
        isCollectionOwner(resource.data.collectionId) ||
        hasCollectionEditAccess(resource.data.collectionId) ||
        isDefaultCollection(resource.data.collectionId)
      );
      allow delete: if isAuthenticated() && (
        isCollectionOwner(resource.data.collectionId) ||
        isDefaultCollection(resource.data.collectionId)
      );
    }
    match /collectionStats/{statsId} {
      allow read: if isAuthenticated() && (
        exists(/databases/$(database)/documents/collections/$(resource.data.collectionId)) &&
        (
          get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.isPublic == true ||
          get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.userId == request.auth.uid ||
          isCollectionCollaborator(resource.data.collectionId) ||
          isDefaultCollection(resource.data.collectionId)
        )
      );
      allow create: if isAuthenticated() && (
        isCollectionOwner(request.resource.data.collectionId) ||
        isDefaultCollection(request.resource.data.collectionId)
      );
      allow update, delete: if false; // Only through functions
    }
    match /collectionSharing/{sharingId} {
      allow read: if isAuthenticated() && (
        isCollectionOwner(sharingId) ||
        resource.data.collaborators[request.auth.uid] != null ||
        (resource.data.visibility == 'link' && request.auth.token.email == resource.data.shareLink.allowedEmail) ||
        isDefaultCollection(sharingId)
      );
      allow create: if isAuthenticated() && (
        isCollectionOwner(request.resource.data.collectionId) ||
        isDefaultCollection(request.resource.data.collectionId)
      );
      allow update: if isAuthenticated() && (
        isCollectionOwner(resource.data.collectionId) ||
        (resource.data.collaborators[request.auth.uid].role == 'editor' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessLog'])) ||
        isDefaultCollection(resource.data.collectionId)
      );
      allow delete: if isAuthenticated() && (
        isCollectionOwner(resource.data.collectionId) ||
        isDefaultCollection(resource.data.collectionId)
      );
    }
    match /collectionAchievements/{achievementId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/collections/$(resource.data.collectionId)) &&
        (
          get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.isPublic == true ||
          get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.userId == request.auth.uid ||
          isCollectionCollaborator(resource.data.collectionId) ||
          isDefaultCollection(resource.data.collectionId)
        ))
      );
      allow write: if false; // Only through functions
    }
    match /collectionTrades/{tradeId} {
      allow read: if isAuthenticated() && (
        resource.data.initiatorId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        request.resource.data.initiatorId == request.auth.uid &&
        request.resource.data.offer.size() == 2 &&
        // Verify collection ownership for traded cards
        request.resource.data.offer[0].cards.size() > 0 &&
        request.resource.data.offer[0].cards.hasAll(['collectionId']) &&
        (isCollectionOwner(request.resource.data.offer[0].cards[0].collectionId) ||
         isDefaultCollection(request.resource.data.offer[0].cards[0].collectionId));
      allow update: if isAuthenticated() && (
        resource.data.initiatorId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      ) && (
        // Only allow updating specific fields
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'offer', 'messages', 'verification', 'updatedAt']) ||
        // Or completing the trade
        (request.resource.data.status == 'completed' && 
         resource.data.verification.initiatorConfirmed && 
         resource.data.verification.recipientConfirmed)
      );
      allow delete: if false; // Trades are archived, not deleted
    }
    match /collectionDisplay/{displayId} {
      allow read: if isAuthenticated() && (
        exists(/databases/$(database)/documents/collections/$(resource.data.collectionId)) &&
        (
          get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.isPublic == true ||
          get(/databases/$(database)/documents/collections/$(resource.data.collectionId)).data.userId == request.auth.uid ||
          isCollectionCollaborator(resource.data.collectionId) ||
          isDefaultCollection(resource.data.collectionId)
        )
      );
      allow create: if isAuthenticated() && (
        isCollectionOwner(request.resource.data.collectionId) ||
        isDefaultCollection(request.resource.data.collectionId)
      );
      allow update: if isAuthenticated() && (
        isCollectionOwner(resource.data.collectionId) ||
        hasCollectionEditAccess(resource.data.collectionId) ||
        isDefaultCollection(resource.data.collectionId)
      );
      allow delete: if false;
    }

    // booster-packs rules
match /boosterPacks/{packId} {
  allow read: if isAuthenticated() && (
    resource.data.isPublic == true || 
    resource.data.userId == request.auth.uid
  );
  allow create: if isAuthenticated() 
    && isValidPack(request.resource.data);
  allow update: if isAuthenticated() 
    && resource.data.userId == request.auth.uid
    && isValidPack(request.resource.data)
    && request.resource.data.userId == resource.data.userId;
  allow delete: if isAuthenticated() 
    && resource.data.userId == request.auth.uid
    && resource.data.status != 'published';

  // Pack favorites subcollection
  match /favorites/{userId} {
    allow read: if isAuthenticated();
    allow create, delete: if isAuthenticated() && request.auth.uid == userId;
  }
}
match /packOpenings/{openingId} {
  allow read: if isAuthenticated() && (
    resource.data.userId == request.auth.uid ||
    get(/databases/$(database)/documents/boosterPacks/$(resource.data.packId)).data.userId == request.auth.uid
  );
  allow create: if isAuthenticated() 
    && isValidPackOpening(request.resource.data)
    && canOpenPack(request.resource.data.packId);
  allow update: if false; // Pack openings are immutable
  allow delete: if false; // Pack openings are permanent
}
match /packAnalytics/{analyticsId} {
  allow read: if isAuthenticated() && isPackAnalyticsOwner(resource.data.packId);
  allow write: if false; // Only through server functions
}
match /packCollections/{collectionId} {
  allow read: if isAuthenticated() && (
    resource.data.isPublic == true || 
    resource.data.userId == request.auth.uid
  );
  allow create: if isAuthenticated() 
    && isValidPackCollection(request.resource.data);
  allow update: if isAuthenticated() 
    && resource.data.userId == request.auth.uid
    && isValidPackCollection(request.resource.data)
    && request.resource.data.userId == resource.data.userId;
  allow delete: if isAuthenticated() 
    && resource.data.userId == request.auth.uid;
}
match /packTemplates/{templateId} {
  allow read: if isAuthenticated() && (
    resource.data.isActive == true || 
    resource.data.userId == request.auth.uid
  );
  allow create: if isAuthenticated() 
    && isValidPackTemplate(request.resource.data);
  allow update: if isAuthenticated() 
    && resource.data.userId == request.auth.uid
    && isValidPackTemplate(request.resource.data)
    && request.resource.data.userId == resource.data.userId;
  allow delete: if isAuthenticated() 
    && resource.data.userId == request.auth.uid
    && resource.data.usageCount == 0;
}

    // image generation rules
    match /imageGenerations/{generationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.prompt.size() > 0
        && request.resource.data.status == 'pending';
      allow update: if isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'results', 'error', 'completedAt', 'updatedAt']);
      allow delete: if false;
    }

    // claims rules
    match /claimPools/{poolId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.status == 'active' &&
        request.resource.data.currentClaims == 0 &&
        request.resource.data.claims == {} &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated() && 
        (
          // Allow updating claims and counts
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['claims', 'currentClaims', 'status', 'updatedAt']) &&
            request.resource.data.currentClaims <= request.resource.data.totalLimit &&
            request.resource.data.updatedAt == request.time
          ) ||
          // Allow owner to update other fields
          isOwner(resource.data.userId)
        );
    }
    match /claimEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt == request.time;
    }
    match /claimStats/{statsId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        request.resource.data.updatedAt == request.time;
    }
  }
}

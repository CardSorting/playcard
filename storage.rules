rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Allow authenticated users to upload images to card-images directory
    match /card-images/{imageId} {
      allow write: if request.auth != null 
        && request.resource.size < 5 * 1024 * 1024 // 5MB max file size
        && request.resource.contentType.matches('image/.*'); // Must be an image
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Claim Pools
    match /claimPools/{poolId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.resource.data.status == 'active' &&
        request.resource.data.currentClaims == 0 &&
        request.resource.data.claims == {} &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn() && 
        (
          // Allow updating claims and counts
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['claims', 'currentClaims', 'status', 'updatedAt']) &&
            request.resource.data.currentClaims <= request.resource.data.totalLimit &&
            request.resource.data.updatedAt == request.time
          ) ||
          // Allow owner to update other fields
          isOwner(resource.data.userId)
        );
    }

    // Claim Events
    match /claimEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt == request.time;
    }

    // Claim Stats
    match /claimStats/{statsId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && 
        request.resource.data.updatedAt == request.time;
    }
  }
}
